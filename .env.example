# Starmap Server Configuration
# Copy this file to .env and customize for your deployment

# ============================================================================
# Server Settings
# ============================================================================

# Bind address (use 0.0.0.0 for Docker, localhost for local dev)
HTTP_HOST=0.0.0.0

# Server port
HTTP_PORT=8080

# ============================================================================
# Catalog Settings (Optional)
# ============================================================================
# These are the only catalog settings that starmap reads. Each line shows the
# canonical name and its default. Leave every line commented to pull the public
# attested channel. A flag of the same name in kebab case overrides one setting
# for one command, for example --catalog-source-poll-interval 30m.

# Upstream source: public, github, starmap, file, or embedded
#STARMAP_CATALOG_SOURCE=public

# Safe endpoint or file identity of a custom source
#STARMAP_CATALOG_SOURCE_URL=

# Starmap protocol credential. It is never a provider credential.
#STARMAP_CATALOG_SOURCE_API_KEY=

# GitHub repository and mutable channel that publish the catalog
#STARMAP_CATALOG_SOURCE_REPOSITORY=agentstation/starmap
#STARMAP_CATALOG_SOURCE_CHANNEL=catalog-latest

# Accepted build provenance. An empty value accepts the repository default.
#STARMAP_CATALOG_SOURCE_SIGNER_WORKFLOW=

# Optional GitHub API token. Public local use needs no token.
#STARMAP_CATALOG_SOURCE_TOKEN=

# Conditional channel check period
#STARMAP_CATALOG_SOURCE_POLL_INTERVAL=1h

# What the server serves before the first upstream reply
#STARMAP_CATALOG_SOURCE_STARTUP_POLICY=prefer_source

# Source freshness objective and accepted cascade depth
#STARMAP_CATALOG_SOURCE_MAX_AGE=6h
#STARMAP_CATALOG_SOURCE_MAX_HOPS=8

# Other names of this instance in a cascade. A chain that names one of them
# is a self reference, so the runtime refuses it.
#STARMAP_CATALOG_SOURCE_ALIASES=replica-a,catalog.example.com

# Automatic provider acquisition. Zero interval runs one startup pass.
#STARMAP_CATALOG_ACQUISITION_ENABLED=true
#STARMAP_CATALOG_ACQUISITION_INTERVAL=4h

# How long a completed provider observation waits for a slower sibling
#STARMAP_CATALOG_COALESCE_WINDOW=30s

# Reviewed operator catalog input
#STARMAP_CATALOG_WORKSPACE_PATH=~/.starmap/catalog

# Stable admission window for cold automatic work
#STARMAP_CATALOG_STARTUP_SPREAD=15m

# Transfer bounds for one HTTP body
#STARMAP_CATALOG_TRANSFER_IDLE_TIMEOUT=2m
#STARMAP_CATALOG_TRANSFER_MAX_DURATION=60m

# Whole-operation wall-clock cap. Zero adds no cap.
#STARMAP_CATALOG_REFRESH_TIMEOUT=0s

# Process-local runtime state directory
#STARMAP_STATE_DIR=~/.starmap/state/runtime

# Stable instance identity. An empty value derives one.
#STARMAP_SCHEDULER_IDENTITY=

# ============================================================================
# Provider API Keys (Optional)
# ============================================================================
# Uncomment and set API keys to enable live data fetching from providers
# Without API keys, starmap will use the embedded catalog data

# OpenAI
#OPENAI_API_KEY=sk-...

# Anthropic
#ANTHROPIC_API_KEY=sk-ant-...

# Google AI Studio
#GOOGLE_API_KEY=...

# Groq
#GROQ_API_KEY=...

# DeepSeek
#DEEPSEEK_API_KEY=...

# Cerebras
#CEREBRAS_API_KEY=...

# Hetzner Inference
#HETZNER_API_KEY=...

# Alibaba Cloud Model Studio
#DASHSCOPE_API_KEY=...
# Optional non-US workspace base URL, for example:
#ALIBABA_MODEL_STUDIO_BASE_URL=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# Fireworks AI
#FIREWORKS_API_KEY=...

# DeepInfra (optional for catalog fetch; required for inference)
#DEEPINFRA_TOKEN=...

# ============================================================================
# Google Vertex AI (Optional)
# ============================================================================
# For Google Vertex AI, you need project and location
# Authentication uses Application Default Credentials (ADC)

#GOOGLE_VERTEX_PROJECT=my-gcp-project
#GOOGLE_VERTEX_LOCATION=us-central1

# Optional: Path to service account key file
# Mount this file as a volume in docker-compose.yml
#GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-key.json

# ============================================================================
# Logging (Optional)
# ============================================================================
# Log level: trace, debug, info, warn, error
#LOG_LEVEL=info

# CORS is configured explicitly with starmap serve --cors/--cors-origins.
