+def decode_review_json_gzip(content: bytes) -> str:
+    if len(content) > MAX_JSON_GZIP_BYTES:
+        raise SystemExit("JSON-gzip compressed input exceeds the review limit")
+    try:
+        # Optional headers can carry unreviewed strings. Accept one member with
+        # the fixed header only; do not discard comments or concatenated members.
+        if len(content) < 18 or content[:4] != b"\x1f\x8b\x08\x00":
+            raise ValueError("unsupported gzip header")
+        decoder = zlib.decompressobj(wbits=31)
+        decoded = decoder.decompress(content, MAX_JSON_DECODED_BYTES + 1)
+        if len(decoded) > MAX_JSON_DECODED_BYTES:
+            raise SystemExit("JSON-gzip decoded input exceeds the review limit")
+        if not decoder.eof or decoder.unused_data or decoder.unconsumed_tail:
+            raise ValueError("incomplete or concatenated gzip member")
+        text = decoded.decode("utf-8")
+        # Validate without changing number precision or spelling.
+        def reject_constant(_value: str) -> None:
+            raise ValueError("non-JSON constant")
+        json.loads(text, parse_int=str, parse_float=str, parse_constant=reject_constant)
+    except (OSError, EOFError, UnicodeError, ValueError, RecursionError, zlib.error):
+        raise SystemExit("invalid gzip or UTF-8 JSON in review input") from None
+
+    # Insert layout only outside strings. Preserve duplicate keys, number tokens,
+    # string escapes, and key order so normalization cannot hide a content change.
+    output = io.StringIO()
+    depth = 0
+    quoted = False
+    escaped = False
+    for char in text:
+        if quoted:
+            output.write(char)
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == '"':
+                quoted = False
+        elif char == '"':
+            quoted = True
+            output.write(char)
+        elif char in "[{":
+            depth += 1
+            if depth > 64:
+                raise SystemExit("JSON-gzip nesting exceeds the review limit")
+            output.write(char + "\n" + "  " * depth)
+        elif char in "]}":
+            depth -= 1
+            output.write("\n" + "  " * depth + char)
+        elif char == ",":
+            output.write(",\n" + "  " * depth)
+        elif char == ":":
+            output.write(": ")
+        elif char not in " \t\r\n":
+            output.write(char)
+        if output.tell() > MAX_JSON_RENDERED_BYTES:
+            raise SystemExit("JSON-gzip rendered input exceeds the review limit")
+    rendered = output.getvalue() + "\n"
+    if len(rendered.encode("utf-8")) > MAX_JSON_RENDERED_BYTES:
+        raise SystemExit("JSON-gzip rendered input exceeds the review limit")
+    return rendered
